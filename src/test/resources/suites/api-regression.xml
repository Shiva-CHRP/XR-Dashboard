<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="VEMS Super Admin - API Regression Suite" verbose="1">

    <listeners>
        <listener class-name="superadmin.listener.Listener"/>
    </listeners>

    <test name="API Regression Tests" preserve-order="true">
        <groups>
            <run>
                <include name="Regression"/>
                <include name="Smoke"/>
            </run>
        </groups>
        <packages>
            <package name="api.identity"/>
            <package name="api.gateway"/>
            <package name="api.user"/>
            <package name="api.license"/>
            <package name="api.client"/>
            <package name="api.notification"/>
            <package name="api.offline"/>
        </packages>
    </test>

</suite>
