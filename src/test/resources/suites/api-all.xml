<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="VEMS Super Admin - Full Backend API Automation Suite" verbose="1">

    <listeners>
        <listener class-name="superadmin.listener.Listener"/>
    </listeners>

    <test name="Identity Service API Tests" preserve-order="true">
        <classes>
            <class name="api.identity.IdentityServiceApiTest"/>
        </classes>
    </test>

    <test name="Gateway API Tests" preserve-order="true">
        <classes>
            <class name="api.gateway.GatewayApiTest"/>
        </classes>
    </test>

    <test name="User Service API Tests" preserve-order="true">
        <classes>
            <class name="api.user.UserServiceApiTest"/>
        </classes>
    </test>

    <test name="License Service API Tests" preserve-order="true">
        <classes>
            <class name="api.license.LicenseServiceApiTest"/>
        </classes>
    </test>

    <test name="Client Service API Tests" preserve-order="true">
        <classes>
            <class name="api.client.ClientServiceApiTest"/>
        </classes>
    </test>

    <test name="Notification Service API Tests" preserve-order="true">
        <classes>
            <class name="api.notification.NotificationServiceApiTest"/>
        </classes>
    </test>

    <test name="Offline Service API Tests" preserve-order="true">
        <classes>
            <class name="api.offline.OfflineServiceApiTest"/>
        </classes>
    </test>

    <test name="Cross-Service E2E Integration API Tests" preserve-order="true">
        <classes>
            <class name="api.e2e.BackendUserLicenseE2ETest"/>
            <class name="api.e2e.GatewayMaintenanceE2ETest"/>
        </classes>
    </test>

</suite>
