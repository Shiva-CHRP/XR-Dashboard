<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SuperAdmin Full Regression Suite" verbose="1">

    <listeners>
        <listener class-name="superadmin.listener.Listener"/>
    </listeners>

    <test name="SuperAdmin Core Smoke &amp; Role Switch" preserve-order="true">
        <classes>
            <class name="superadmin.tests.SmokeTest"/>
            <class name="superadmin.tests.RoleSwitchTest"/>
        </classes>
    </test>

    <test name="SuperAdmin Post-Deployment Sanity" preserve-order="true">
        <classes>
            <class name="superadmin.tests.DeploymentSanityTest"/>
        </classes>
    </test>

    <test name="SuperAdmin Lifecycle E2E Tests" preserve-order="true">
        <classes>
            <class name="superadmin.tests.OrganizationTest"/>
            <class name="superadmin.tests.CatalogueAndGovernanceTest"/>
            <class name="superadmin.tests.DeveloperPortalTest"/>
        </classes>
    </test>

    <test name="SuperAdmin Security &amp; Edge Cases" preserve-order="true">
        <classes>
            <class name="superadmin.tests.SuperAdminAuthNegativeTest"/>
            <class name="superadmin.tests.SuperAdminFormValidationEdgeTest"/>
            <class name="superadmin.tests.SuperAdminSearchAndFilterEdgeTest"/>
        </classes>
    </test>

</suite>
