<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CHRP Platform Multi-Portal Smoke Suite" verbose="1">

    <listeners>
        <listener class-name="superadmin.listener.Listener"/>
    </listeners>

    <test name="SuperAdmin Core Smoke Tests" preserve-order="true">
        <classes>
            <class name="superadmin.tests.SmokeTest"/>
            <class name="superadmin.tests.RoleSwitchTest"/>
        </classes>
    </test>

    <test name="ClientPortal Multi-Role Smoke Tests" preserve-order="true">
        <classes>
            <class name="clientportaladmin.tests.ClientSmokeTest"/>
            <class name="clientportalmanager.tests.ManagerSmokeTest"/>
            <class name="clientportaltrainer.tests.TrainerSmokeTest"/>
        </classes>
    </test>

</suite>
