<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CHRP Platform Multi-Portal Sanity Suite" verbose="1">

    <listeners>
        <listener class-name="superadmin.listener.Listener"/>
    </listeners>

    <test name="SuperAdmin Post-Deployment Verification" preserve-order="true">
        <classes>
            <class name="superadmin.tests.DeploymentSanityTest"/>
        </classes>
    </test>

    <test name="ClientPortal Post-Deployment Verification" preserve-order="true">
        <classes>
            <class name="clientportaladmin.tests.ClientDeploymentSanityTest"/>
        </classes>
    </test>

</suite>
